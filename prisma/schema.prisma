generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Realm {
  customer
  staff
}

enum AuditAction {
  REGISTER
  LOGIN
  REFRESH
  LOGOUT
  LOGOUT_ALL
  PREFERENCES_UPDATE
  STAFF_CREATE
  STAFF_ROLE_CHANGE
  STAFF_STATUS_CHANGE
  PASSWORD_CHANGE
  SIZE_GUIDE_UPDATE
  SIZE_GUIDE_RESET
  SIZE_CREATE
  SIZE_RENAME
  SIZE_DELETE
  SIZE_RESET
}

enum AccountStatus {
  active
  suspended
}

/// `role` is a dashboard role *id* as a string, not a Prisma enum: the client
/// owns the role catalogue and can add or edit roles (Team → Roles) without a
/// server deploy, and `rolesSeed.js` is the list of ids in play today —
/// "super-admin", "staff", "finance", "support", "content", "developer".
/// `customers` hold the literal "customer".
///
/// The role is stored and returned so the dashboard knows who it is talking to.
/// It is NOT a full capability system: the per-section none/view/edit matrix
/// still lives in the client (`client/src/utils/permissions.js`), and the server
/// enforces exactly one thing — the staff-management routes require
/// "super-admin" (`requireRole`). Treat the browser's other capability checks as
/// an affordance, not a control.
///
/// `status` is the server's own "this account cannot sign in" switch, and it is
/// not the role: a role change is a promotion or a demotion, whereas suspension
/// ends access now. A suspended account is refused at sign-in and refused on
/// every existing token, and all of its sessions are deleted, because a role
/// change alone leaves the person able to sign straight back in.
model User {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  realm        Realm
  email        String
  passwordHash String
  name         String?
  role         String     @default("staff")
  preferences  Json?
  tokenVersion Int        @default(0)
  /// Set when an account was created by another admin with a temporary
  /// password. Such an account may sign in and change its password, but the
  /// dashboard gate keeps it out of the app until the flag clears, so a
  /// password that was read aloud in a meeting cannot stay valid for good.
  mustChangePassword Boolean @default(false)
  /// Sign-in is refused while this is "suspended". Kept as a column rather than
  /// inferred from a missing role so an account can be switched back on without
  /// anyone having to remember what it used to be.
  status     AccountStatus @default(active)
  /// When it was suspended, for the roster and the audit trail. Null while active.
  suspendedAt DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  sessions     Session[]
  auditLogs    AuditLog[]

  @@unique([realm, email])
  @@index([realm, role])
  @@map("users")
}

/// One row per active device / browser. A login creates a row; logout/logout-all
/// deletes the matching rows. The refreshHash is the SHA-256 of the refresh token
/// so the raw token is never stored.
model Session {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  userId        String    @db.ObjectId
  realm         Realm
  refreshHash   String    @unique
  refreshExpiry DateTime
  userAgent     String?
  ip            String?
  createdAt     DateTime  @default(now())
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// Append-only record of every auth event for compliance and security UX.
model AuditLog {
  id        String      @id @default(auto()) @map("_id") @db.ObjectId
  userId    String      @db.ObjectId
  realm     Realm
  action    AuditAction
  ip        String?
  userAgent String?
  meta      Json?
  createdAt DateTime    @default(now())
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

/// One size guide — "garment", "footwear" or "hair" — exactly as the dashboard
/// edits it and the storefront reads it.
///
/// One document per guide rather than one blob for all three, because each guide
/// is saved as a unit: a single `PUT` replaces a whole guide, so a rejected row
/// leaves the previous guide intact instead of half-applied. It also stops two
/// people editing different guides from overwriting each other, which is what
/// happened when all three shared one `howToMeasure` key.
///
/// `type` is a plain String, not an enum: Prisma does not enforce enums on the
/// MongoDB provider, so the real guarantee is the zod schema on the way in
/// (GUIDE_TYPES), the same way `User.role` is checked by the caller.
model SizeGuide {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  /// "garment" | "footwear" | "hair" — decides which table shapes `data` holds.
  type      String
  /// The whole guide, shaped by `type`. Held as one document rather than
  /// normalised into rows, because a guide is read and written as a single unit
  /// and its three shapes are unrelated to each other.
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([type])
  @@map("size_guides")
}

/// One entry in the size list — "M", "EU 38 · UK 3 · US 5", "One Size" — that a
/// category offers from and a product picks within.
///
/// Separate from `SizeGuide` on purpose. A guide is the measurement table that
/// explains what a size means; this is the list of sizes that exist. They are
/// not a hierarchy, and they are not guaranteed to agree: a guide may carry a
/// row the list has no entry for, and a size in the list may have no
/// measurements. Forcing them into one document would mean editing a size name
/// rewrites a guide, and the two would lose the ability to drift apart — which
/// is the normal state while the catalogue is still being built out.
///
/// `id` is permanent and is NOT derived from `name`. It is a public contract in
/// three places that no migration may break: it is a key in a product's
/// `colorways[].stock` object, it is a segment of a bookmarked `?size=eu38,m`
/// storefront URL, and `sizeChartKind.js` decides which guide a product needs
/// by pattern-matching the id. A rename therefore only ever changes `name`; the
/// service refuses to reuse or reassign an id, and the PATCH route rejects an
/// `id` in the body rather than letting a client re-point all three at once.
///
/// `position` is load-bearing, not decoration. The order sizes appear in is the
/// order a shopper reads them in the facet, and `CategoryDialog` re-sorts a
/// category's ticked sizes into it, so it has to be stored rather than left to
/// insertion order.
model Size {
  id        String   @id @map("_id")
  name      String
  position  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([position])
  @@map("sizes")
}

/// An id that has been spent and must never be issued again.
///
/// A size id outlives its row. Deleting a size does not un-reference it — the
/// products that carried it still do, in the browser's catalogue, and their
/// `colorways[].stock` is an object *keyed by that id*. If the id were handed to
/// the next size created, every one of those products would silently re-point at
/// a different size, with stock counts to match, and nothing in the write path
/// would have any idea it happened.
///
/// So a delete writes the id here as well, and `createSize` treats this
/// collection as taken along with the live one. The unique index on
/// (kind, ref) is what makes that safe under concurrency: two requests racing to
/// claim the same freed id cannot both succeed.
///
/// Rows here are intentionally never cleaned up. An id being permanently
/// unavailable is the desired state, and a retention policy would eventually
/// re-open the hole this exists to close.
model FreedId {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  /// Which resource spent it. "size" today; the discriminator is here so a
  /// second resource can keep its own namespace without colliding on a string.
  kind      String
  /// The spent id itself.
  ref       String
  createdAt DateTime @default(now())

  @@unique([kind, ref])
  @@index([kind])
  @@map("freed_ids")
}