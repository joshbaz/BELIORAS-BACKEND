generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Realm {
  customer
  staff
}

enum AuditAction {
  REGISTER
  LOGIN
  LOGIN_FAILED
  REFRESH
  LOGOUT
  LOGOUT_ALL
  PREFERENCES_UPDATE
  STAFF_CREATE
  STAFF_ROLE_CHANGE
  STAFF_STATUS_CHANGE
  PASSWORD_CHANGE
  PROFILE_UPDATE
  PASSWORD_RESET_REQUEST
  PASSWORD_RESET
  SIZE_GUIDE_UPDATE
  SIZE_GUIDE_RESET
  SIZE_CREATE
  SIZE_RENAME
  SIZE_DELETE
  SIZE_RESET
  CATEGORY_CREATE
  CATEGORY_UPDATE
  CATEGORY_DELETE
  CATEGORY_REORDER
  CATEGORY_RESET
  COLOR_CREATE
  COLOR_UPDATE
  COLOR_DELETE
  COLOR_RESET
  NAVIGATION_UPDATE
  NAVIGATION_RESET
  HOME_TILES_UPDATE
  PRODUCT_CREATE
  PRODUCT_UPDATE
  PRODUCT_DELETE
  PRODUCT_RESTORE
  STOCK_ADJUST
  STOCK_RECEIVE
  STOCK_ORDER
  INVENTORY_SETTINGS
  ORDER_STATUS
  ORDER_CANCEL
  ORDER_REFUND
  ORDER_RESEND
  COUPON_CREATE
  COUPON_UPDATE
  COUPON_DELETE
  SETTINGS_UPDATE
  REVIEW_PUBLISH
  REVIEW_HIDE
  REVIEW_REPLY
  NEWSLETTER_UPDATE
  CAMPAIGN_SAVE
  CAMPAIGN_SEND
  CAMPAIGN_DELETE
  SUBSCRIBER_UNSUBSCRIBE
  SUBSCRIBER_ERASE
  ROLE_CREATE
  ROLE_UPDATE
  ROLE_DELETE
  MODEL_CREATE
  MODEL_UPDATE
  MODEL_DELETE
  TAXONOMY_UPDATE
}

enum AccountStatus {
  active
  suspended
}

/// `role` is a dashboard role *id* as a string, not a Prisma enum: the client
/// owns the role catalogue and can add or edit roles (Team → Roles) without a
/// server deploy, and `rolesSeed.js` is the list of ids in play today —
/// "super-admin", "staff", "finance", "support", "content", "developer".
/// `customers` hold the literal "customer".
///
/// The role is stored and returned so the dashboard knows who it is talking to.
/// It is NOT a full capability system: the per-section none/view/edit matrix
/// still lives in the client (`client/src/utils/permissions.js`), and the server
/// enforces exactly one thing — the staff-management routes require
/// "super-admin" (`requireRole`). Treat the browser's other capability checks as
/// an affordance, not a control.
///
/// `status` is the server's own "this account cannot sign in" switch, and it is
/// not the role: a role change is a promotion or a demotion, whereas suspension
/// ends access now. A suspended account is refused at sign-in and refused on
/// every existing token, and all of its sessions are deleted, because a role
/// change alone leaves the person able to sign straight back in.
model User {
  id                 String        @id @default(auto()) @map("_id") @db.ObjectId
  realm              Realm
  email              String
  passwordHash       String
  name               String?
  /// A shopper's contact number, prefilled at checkout. Optional.
  phone              String?
  role               String        @default("staff")
  preferences        Json?
  tokenVersion       Int           @default(0)
  /// Set when an account was created by another admin with a temporary
  /// password. Such an account may sign in and change its password, but the
  /// dashboard gate keeps it out of the app until the flag clears, so a
  /// password that was read aloud in a meeting cannot stay valid for good.
  mustChangePassword Boolean       @default(false)
  /// Sign-in is refused while this is "suspended". Kept as a column rather than
  /// inferred from a missing role so an account can be switched back on without
  /// anyone having to remember what it used to be.
  status             AccountStatus @default(active)
  /// When it was suspended, for the roster and the audit trail. Null while active.
  suspendedAt        DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  sessions           Session[]
  auditLogs          AuditLog[]

  @@unique([realm, email])
  @@index([realm, role])
  @@map("users")
}

/// One row per active device / browser. A login creates a row; logout/logout-all
/// deletes the matching rows. The refreshHash is the SHA-256 of the refresh token
/// so the raw token is never stored.
model Session {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  userId        String   @db.ObjectId
  realm         Realm
  refreshHash   String   @unique
  refreshExpiry DateTime
  userAgent     String?
  ip            String?
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// Append-only record of every auth event for compliance and security UX.
model AuditLog {
  id        String      @id @default(auto()) @map("_id") @db.ObjectId
  /// Who it happened to. Absent only for a failed sign-in with an email that
  /// has no account (the email is then in `meta`).
  userId    String?     @db.ObjectId
  realm     Realm
  action    AuditAction
  ip        String?
  userAgent String?
  meta      Json?
  createdAt DateTime    @default(now())
  user      User?       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

/// One size guide — "garment", "footwear" or "hair" — exactly as the dashboard
/// edits it and the storefront reads it.
///
/// One document per guide rather than one blob for all three, because each guide
/// is saved as a unit: a single `PUT` replaces a whole guide, so a rejected row
/// leaves the previous guide intact instead of half-applied. It also stops two
/// people editing different guides from overwriting each other, which is what
/// happened when all three shared one `howToMeasure` key.
///
/// `type` is a plain String, not an enum: Prisma does not enforce enums on the
/// MongoDB provider, so the real guarantee is the zod schema on the way in
/// (GUIDE_TYPES), the same way `User.role` is checked by the caller.
model SizeGuide {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  /// "garment" | "footwear" | "hair" — decides which table shapes `data` holds.
  type      String
  /// The whole guide, shaped by `type`. Held as one document rather than
  /// normalised into rows, because a guide is read and written as a single unit
  /// and its three shapes are unrelated to each other.
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([type])
  @@map("size_guides")
}

/// One entry in the size list — "M", "EU 38 · UK 3 · US 5", "One Size" — that a
/// category offers from and a product picks within.
///
/// Separate from `SizeGuide` on purpose. A guide is the measurement table that
/// explains what a size means; this is the list of sizes that exist. They are
/// not a hierarchy, and they are not guaranteed to agree: a guide may carry a
/// row the list has no entry for, and a size in the list may have no
/// measurements. Forcing them into one document would mean editing a size name
/// rewrites a guide, and the two would lose the ability to drift apart — which
/// is the normal state while the catalogue is still being built out.
///
/// `id` is permanent and is NOT derived from `name`. It is a public contract in
/// three places that no migration may break: it is a key in a product's
/// `colorways[].stock` object, it is a segment of a bookmarked `?size=eu38,m`
/// storefront URL, and `sizeChartKind.js` decides which guide a product needs
/// by pattern-matching the id. A rename therefore only ever changes `name`; the
/// service refuses to reuse or reassign an id, and the PATCH route rejects an
/// `id` in the body rather than letting a client re-point all three at once.
///
/// `position` is load-bearing, not decoration. The order sizes appear in is the
/// order a shopper reads them in the facet, and `CategoryDialog` re-sorts a
/// category's ticked sizes into it, so it has to be stored rather than left to
/// insertion order.
model Size {
  id        String   @id @map("_id")
  name      String
  position  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([position])
  @@map("sizes")
}

/// A category: what a piece is — Dresses, Hair, Accessories — with the sizes it
/// offers and its "Shop by …" subcategories, which hold the product-taggable
/// types. A category has no flat type list of its own.
///
/// `id` is permanent and is NOT derived from `name` after creation. It is every
/// product's `collectionId`, a storefront URL segment (`/dresses`) and a filter
/// token, so a rename only ever changes `name`; a delete spends the id in
/// `FreedId` under kind "category" so it is never handed out again.
///
/// `subcategories` are embedded (`[{id,name,types:[{id,name}]}]`) rather than a
/// collection of their own: they
/// only mean anything inside their category, and are always read and written
/// with it. Their ids are stable across renames the same way — a subcategory
/// type is a product's `subcat:<sub>:<type>` tag — and
/// their array order is the order a shopper reads them in.
///
/// `position` is the category's own display order, set by the dashboard's
/// drag-to-reorder.
model Category {
  id            String   @id @map("_id")
  name          String
  position      Int
  sizes         String[]
  subcategories Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([position])
  @@map("categories")
}

/// A boutique colour — Ebony, Champagne — with its swatch and the shop filter
/// family it is found under (Ebony → black).
///
/// `id` is permanent and is NOT derived from `name` after creation: products
/// store their colourways by colour id (`colorways[].colorId`), and a mega-menu
/// or facet resolves through it, so a rename reaches every product rather than
/// orphaning them. A delete spends the id in `FreedId` (kind "color").
///
/// `family` is a taxonomy colour id (black, brown, red…). That list is still
/// client-side, so the server checks only the id's shape.
model Color {
  id        String   @id @map("_id")
  name      String
  hex       String
  family    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("colors")
}

/// The storefront's mega menu: top-level items, their columns of links, and
/// feature tiles — one ordered tree, stored as one document (`id` "main").
///
/// One document rather than rows, because the menu is edited and saved as a
/// whole: a reorder touches every sibling, and a half-applied save would leave
/// links pointing at columns that moved. Every node's `url` is generated once
/// and stored, so renaming a link never breaks a shared address.
///
/// `version` goes up on every save. A save names the version it was edited
/// from, and a stale one is refused (409), so two people editing the menu at
/// once cannot silently overwrite each other's work.
model Navigation {
  id        String   @id @map("_id")
  items     Json
  version   Int      @default(1)
  updatedAt DateTime @updatedAt

  @@map("navigation")
}

/// A piece in the catalogue.
///
/// The columns are what the server's own rules and queries need: the address
/// (`slug`, unique), what the shop may show (`status`, `deletedAt`), where it
/// is filed (`collectionId`, `tags`), and stock (`stock`, `colorways`, `sizes`).
/// Everything else a piece carries — description, care, photos, hair length,
/// cost price… — is `attributes`, so a new field reaches the shop without a
/// migration. The service flattens the two back into one object.
///
/// `id` is permanent and never reissued: order lines and the stock history
/// reference it. A delete is soft (`deletedAt`), which is also what lets the
/// dashboard's Undo bring the very same piece back; a new piece's id is
/// numbered past every row, deleted ones included.
///
/// Stock lives in `colorways[].stock[size]` for a piece counted per colour and
/// size, or `stock` alone for one that is not; `stock` is always the total.
/// Every change to it writes a `StockMovement` in the same transaction.
model Product {
  id           String    @id @map("_id")
  slug         String    @unique
  name         String
  status       String
  collectionId String
  price        Float
  stock        Int
  sizes        String[]
  tags         String[]
  colorways    Json?
  attributes   Json
  /// Goes up on every product-form save, and only then: stock moving does not
  /// touch it. A form save names the version it opened, so two editors cannot
  /// silently overwrite each other's names, prices or photos. Null on rows
  /// written before it existed, which counts as 1.
  editVersion  Int?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@index([collectionId])
  @@index([status])
  @@map("products")
}

/// One change to what is on the shelf, and why. Written in the same
/// transaction as the stock change itself, so the history and the count can
/// never disagree. `colorId`/`size` are "*" for a piece counted as one number.
model StockMovement {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  productId   String
  colorId     String
  size        String
  delta       Int
  onHandAfter Int
  /// received · adjusted · counted · damaged · sold · returned
  reason      String
  orderId     String?
  note        String?
  /// Who made the change, by name as the dashboard shows it.
  by          String?
  at          DateTime @default(now())

  @@index([productId, at])
  @@map("stock_movements")
}

/// Small shop-wide settings documents, keyed by section ("inventory").
model Setting {
  id        String   @id @map("_id")
  value     Json
  updatedAt DateTime @updatedAt

  @@map("settings")
}

/// An order: what was sold, to whom, for how much, and where it has got to.
///
/// `id` is the customer-facing reference ("ORD-1042"), numbered by `Counter`
/// and never reused. `items` are snapshots — name, price, photo, colour and
/// size as sold — so an order keeps describing the sale after the product
/// changes. `invoiceNumber` is issued once, in sequence, when payment is
/// confirmed; `creditNotes` are appended by refunds and never edited.
///
/// Status follows `utils/orderStatus.js`: to-pay → to-ship → shipped →
/// to-review (delivered) → reviewed, or cancelled / refunded. Orders in to-pay
/// and to-ship hold their units: available = on hand − held.
model Order {
  id              String    @id @map("_id")
  userId          String?
  email           String
  name            String?
  phone           String?
  items           Json
  subtotal        Float
  discount        Float
  shipping        Float
  tax             Float
  total           Float
  couponCode      String?
  country         String?
  shippingAddress String?
  status          String
  /// Unique by construction (issued once from `Counter`), not by index: a
  /// MongoDB unique index would treat every unpaid order's missing number as
  /// the same value and refuse the second one.
  invoiceNumber   String?
  paymentMethod   String?
  paidAt          DateTime?
  shippedAt       DateTime?
  deliveredAt     DateTime?
  trackingRef     String?
  carrier         String?
  cancelReason    String?
  stockDeductedAt DateTime?
  stockReturnedAt DateTime?
  creditNotes     Json
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId])
  @@index([email])
  @@index([status])
  @@index([invoiceNumber])
  @@map("orders")
}

/// Money moving against an order: a charge, or a refund against a charge.
/// Read-only history; `simulated` marks the development payment stand-in.
model Transaction {
  id            String   @id @map("_id")
  orderId       String
  provider      String
  providerRef   String
  type          String
  status        String
  amount        Float
  currency      String
  fee           Float
  method        Json?
  failureReason String?
  parentId      String?
  reason        String?
  simulated     Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([orderId])
  @@map("transactions")
}

/// A discount code. Uses are counted from orders (cancelled and refunded ones
/// hand theirs back), never stored, so the count cannot drift.
model Coupon {
  id                 String    @id @map("_id")
  code               String    @unique
  type               String
  value              Float
  minOrderValue      Float     @default(0)
  maxDiscount        Float?
  maxUses            Int?
  maxUsesPerCustomer Int?
  expiresAt          DateTime?
  active             Boolean   @default(true)
  description        String    @default("")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@map("coupons")
}

/// An email the shop would send, queued until a mail provider is connected.
model Email {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  type      String
  to        String
  subject   String
  orderId   String?
  data      Json
  status    String   @default("queued")
  createdAt DateTime @default(now())

  @@index([orderId])
  @@map("emails")
}

/// Sequences that must never repeat or skip — order references, invoice and
/// credit-note numbers, transaction ids — and per-product locks that make
/// concurrent checkouts for the same piece take turns.
model Counter {
  id    String @id @map("_id")
  value Int

  @@map("counters")
}

/// A password-reset link: one use, one hour. Only the token's hash is stored,
/// so a leaked database cannot be used to reset anyone's password.
model PasswordReset {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  userId    String    @db.ObjectId
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_resets")
}

/// A shopper's review of a piece. Lands `pending` and shows nowhere until a
/// moderator publishes it; `hidden` takes it down again. `verified` means the
/// reviewer's account has ordered the piece — a badge, worked out here.
model Review {
  id        String   @id @map("_id")
  productId String
  userId    String?
  name      String
  rating    Int
  title     String   @default("")
  body      String
  verified  Boolean  @default(false)
  status    String   @default("pending")
  reply     Json?
  date      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId, status])
  @@map("reviews")
}

/// Someone on the Belioras Letter's list. Double opt-in: `pending` until the
/// confirmation link is followed; only `subscribed` people are sent campaigns.
/// Unsubscribing keeps the record (so a later import cannot quietly re-add
/// them); erasure, for a GDPR request, deletes it. `token` is the capability
/// in confirmation and unsubscribe links.
model Subscriber {
  id             String    @id @map("_id")
  email          String    @unique
  name           String?
  userId         String?
  status         String
  source         String
  consentText    String
  consentedAt    DateTime
  confirmedAt    DateTime?
  unsubscribedAt DateTime?
  token          String?   @unique
  welcomeCode    String?
  welcomeSentAt  DateTime?

  @@index([status])
  @@map("subscribers")
}

/// A newsletter campaign. A sent one is the record of what went out and is never edited.
model Campaign {
  id          String    @id @map("_id")
  subject     String
  previewText String    @default("")
  heading     String    @default("")
  body        String    @default("")
  productIds  String[]
  cta         Json
  status      String
  sendAt      DateTime?
  sentAt      DateTime?
  recipients  Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("campaigns")
}

/// A message from the contact form, kept so nothing a shopper wrote is lost.
model ContactMessage {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String
  subject   String
  message   String
  createdAt DateTime @default(now())

  @@map("contact_messages")
}

/// A dashboard role: a name, and a level per section — "none", "view" or
/// "edit". Every staff route asks for a section and a level (`requireAccess`),
/// and the answer is read from here, so a role edited under Team → Roles
/// changes what the server allows, not only which buttons show. `locked` is the
/// Administrator: always everything, never edited, never deleted.
model Role {
  id          String   @id @map("_id")
  name        String
  description String   @default("")
  permissions Json
  locked      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("roles")
}

/// A model who wears the pieces in the photographs, with the measurements a
/// shopper compares against their own. A product names her and the size she
/// wears (`modelFit: { modelId, size }`). The id is permanent and, once
/// deleted, never reused (`FreedId` kind "model"): products and "shop this
/// edit" links point at it.
model FitModel {
  id        String   @id @map("_id")
  name      String
  photo     String?
  heightCm  Int?
  bustCm    Int?
  waistCm   Int?
  hipCm     Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("fit_models")
}

/// An id that has been spent and must never be issued again.
///
/// A size id outlives its row. Deleting a size does not un-reference it — the
/// products that carried it still do, in the browser's catalogue, and their
/// `colorways[].stock` is an object *keyed by that id*. If the id were handed to
/// the next size created, every one of those products would silently re-point at
/// a different size, with stock counts to match, and nothing in the write path
/// would have any idea it happened.
///
/// So a delete writes the id here as well, and `createSize` treats this
/// collection as taken along with the live one. The unique index on
/// (kind, ref) is what makes that safe under concurrency: two requests racing to
/// claim the same freed id cannot both succeed.
///
/// Rows here are intentionally never cleaned up. An id being permanently
/// unavailable is the desired state, and a retention policy would eventually
/// re-open the hole this exists to close.
model FreedId {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  /// Which resource spent it: "size", "category" or "color"; the discriminator is here so a
  /// second resource can keep its own namespace without colliding on a string.
  kind      String
  /// The spent id itself.
  ref       String
  createdAt DateTime @default(now())

  @@unique([kind, ref])
  @@index([kind])
  @@map("freed_ids")
}
