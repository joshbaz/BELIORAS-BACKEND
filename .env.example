# Copy to .env and fill in real values. Never commit .env.

# HTTP
PORT=5002
# Loopback only. Use 0.0.0.0 only behind a proxy or in a container.
HOST=127.0.0.1
# Proxies in front of the API: 1 = nginx only, 2 = Netlify's /api proxy + nginx.
TRUST_PROXY=1
NODE_ENV=development

# MongoDB (the docker-compose.yml also runs on 27017 with db "belioras")
DATABASE_URL="mongodb://localhost:27017/belioras"

# Redis (the docker-compose.yml also runs on 6379)
REDIS_URL="redis://localhost:6379"

# Auth secrets. Generate strong ones, e.g.
#   openssl rand -base64 48
# Change these in production; both must be at least 32 characters.
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters

# Token lifetimes (jsonwebtoken notation: milliseconds, or a timespan string).
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# Client origin for CORS. Run in the "development"/"production" style below.
CLIENT_ORIGIN=http://localhost:5173

# How long the auth guard trusts a Redis session before re-reading the
# database (see docs/05-auth.md). Logout-all still takes effect immediately.
SESSION_CACHE_TTL=60s

# Logging level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# Rate limiting (docs/04-http-api.md). Effective in production only — in
# development every request shares the address 127.0.0.1, so the limiters would
# be one bucket for the whole team and a reload loop would lock everyone out.
# Set to "false" to also disable them in production.
RATE_LIMIT_ENABLED=true
# Uploads (docs/04-http-api.md). Set both to store product photos and videos on
# ImageKit's CDN (Dashboard → Developer options). Leave unset in development to
# write them to UPLOAD_DIR and serve them from /api/uploads instead.
# IMAGEKIT_PRIVATE_KEY=private_xxx
# IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id
# UPLOAD_DIR=uploads

# Orders (docs/04-http-api.md). How long an unpaid order holds its stock before
# it lapses and is cancelled. The development payment stand-in is on outside
# production; set PAYMENTS_SIMULATED=false to turn it off, or true to force it.
# ORDER_PAYMENT_TTL_MINUTES=30
# PAYMENTS_SIMULATED=
