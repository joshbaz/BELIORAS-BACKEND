{
  "name": "belioras-server",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Belioras API — Express + Socket.IO + Prisma (MongoDB), versioned at /api/v1.",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "lint": "eslint ."
  },
  "dependencies": {
    "@prisma/client": "6",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "ms": "^2.1.3",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "socket.io": "^4.8.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10",
    "globals": "^17.12.0",
    "pino-pretty": "^13.1.3",
    "prisma": "6.19.3",
    "supertest": "^7.3.0"
  }
}
